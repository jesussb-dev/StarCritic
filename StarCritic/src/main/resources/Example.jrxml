	<parameter name="nombreLista" class="java.lang.String"/>
	<parameter name="id_Usuario" class="java.lang.Integer"/>
	<parameter name="nombreContenido" class="java.util.Map"/>
	<queryString language="SQL">
		<![CDATA[SELECT
    c.ID_contenido,
    c.titulo,
    COALESCE(ca.ID_Api, CAST(v.ID_Api AS CHAR)) AS ID_Api,
    c.tipo_contenido AS tipo
FROM usuario_registrado ur
JOIN lista_usuario lu
     ON lu.ID_usuario_registrado = ur.ID_usuario_registrado
JOIN lista_contenido lc
     ON lc.ID_usuario_registrado = lu.ID_usuario_registrado
    AND lc.nombre_lista          = lu.nombre_lista
JOIN contenido c
     ON c.ID_contenido = lc.ID_contenido
LEFT JOIN contenido_audiovisual ca
     ON ca.ID_contenido_audiovisual = c.ID_contenido
LEFT JOIN videojuego v
     ON v.ID_videojuego = c.ID_contenido
WHERE ur.nombre_usuario =  $P{id_Usuario}
  AND lu.nombre_lista   =   $P{nombreLista}
ORDER BY c.ID_contenido;]]>
	</queryString>
