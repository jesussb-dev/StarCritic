        <mxCell id="-V7SIw517vj5LTt9m3jN-42" connectable="0" parent="-V7SIw517vj5LTt9m3jN-40" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontColor=#9933FF;" value="B:R M:C" vertex="1">
